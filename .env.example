# Copie este archivo a .env (no se versiona) y complete los valores.

# ─── API ───────────────────────────────────────────────────────────────────
PORT=3020
PORT_SWAGGER=8080
# Puerto del equipo donde se publica la API (docker compose)
API_PORT=8080
# URL pública para los enlaces de los correos (verificación y cambio de contraseña).
# Vacía = se usa la del propio request.
APP_BASE_URL=

# ─── Base de datos (DB_HOST lo fija docker compose: db-postgres) ───────────
DB_NAME=marketplace
DB_USER=marketplace
DB_PASS=cambie-esta-clave
DB_PORT_HOST=5555

# ─── JWT (cadenas largas y aleatorias: openssl rand -hex 32) ───────────────
JWT_SECRET=
# Opcionales: si se omiten se usa JWT_SECRET
JWT_EMAIL_VERIFY_SECRET=
JWT_RESET_SECRET=

# ─── Correo (Gmail: Cuenta de Google → Seguridad → Contraseñas de aplicaciones)
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
